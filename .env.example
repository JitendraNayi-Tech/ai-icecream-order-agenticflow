# Default backend: the local Claude Code CLI login (e.g. your Pro/Max subscription); no key needed.
# LLM_BACKEND=claude_code
# CLAUDE_CODE_MODEL=sonnet
# CLAUDE_CODE_ROUTER_MODEL=haiku
# APP_URL=http://127.0.0.1:8000   # change if you run uvicorn on another port

# Alternative: the paid Claude API (setting a key switches the default backend to "api")
# ANTHROPIC_API_KEY=
# ICECREAM_MODEL=claude-opus-5-5

# Optional
# TRACKER_SPEED=1.0   # multiply status delays (0.2 = 5x faster demo)
